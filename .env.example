# Server
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Database (Supabase/Postgres connection string)
DATABASE_URL=postgres://user:password@localhost:5432/solar_monitor

# Auth
JWT_SECRET=change-me-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Encryption key for vendor credentials: 32 bytes as 64 hex characters
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_KEY=

# Scheduler
COLLECT_CRON=*/5 * * * *
DAILY_SUMMARY_CRON=5 0 * * *
DEFAULT_TIMEZONE=Asia/Kolkata
DAYTIME_START_HOUR=7
DAYTIME_END_HOUR=18

# First admin (used by seed script only)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# Vendor / API keys (only if used; never commit real values)
VENDOR_API_KEY=
VENDOR_API_SECRET=

# Web (Vite)
VITE_API_URL=http://localhost:4000/api
